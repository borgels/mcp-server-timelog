{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.borgels/mcp-server-timelog",
  "title": "TimeLog",
  "description": "MCP server for the TimeLog REST API: projects, tasks, customers, employees and time.",
  "repository": {
    "url": "https://github.com/borgels/mcp-server-timelog",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mcp-server-timelog",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TIMELOG_API_KEY",
          "description": "Personal access token (PAT) from login.timelog.com/personaltoken. It has the rights of the user who made it.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "TIMELOG_BASE_URL",
          "description": "The TimeLog account address, https://app<n>.timelog.com/<account>.",
          "isRequired": true,
          "placeholder": "https://app1.timelog.com/youraccount"
        },
        {
          "name": "TIMELOG_ENABLE_WRITES",
          "description": "Enable the write tools.",
          "format": "boolean",
          "default": "false"
        },
        {
          "name": "TIMELOG_DISABLED_TOOLS",
          "description": "Comma-separated tool names to disable."
        },
        {
          "name": "TIMELOG_AUDIT_LOG",
          "description": "Path of the JSONL audit log. Write tools refuse to run if it cannot be written.",
          "format": "filepath"
        }
      ]
    }
  ]
}
